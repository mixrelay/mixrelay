        "muted": false
      },
      "type": "audio_device_input",
      "config": {
        "selector": {
          "match": "default_input"
        },
        "outputChannels": 2,
        "gainDb": 0.0
      }
    },
    {
      "id": "gain",
      "label": null,
      "control": {
        "enabled": true,
        "muted": true
      },
      "type": "gain",
      "config": {
        "channels": 2,
        "gainDb": -6.0
      }
    },
    {
      "id": "speakers",
      "label": "Speakers",
      "control": {
        "enabled": true,
        "muted": false
