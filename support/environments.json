      "scope": "installed-api",
      "required": true,
      "title": "Save and reopen a graph without losing authored routing"
    },
    {
      "id": "AUDIO-01",
      "scope": "native-audio",
      "required": true,
      "title": "Installed native audio preserves the stereo PCM received at the product boundary"
    },
    {
      "id": "REC-02",
      "scope": "installed-api",
      "required": true,
      "title": "Preserve received native PCM in a finalized RF64 recording"
    },
    {
      "id": "AUDIO-12",
      "scope": "native-audio",
      "required": true,
      "os": [
        "macos"
      ],
      "title": "Preserve received silence and audible PCM in both source orders"
    },
    {
      "id": "GRAPH-01",
      "scope": "installed-ui",
      "required": true,
      "title": "Create and connect a routing graph through the installed UI"
    },
    {
      "id": "AUDIO-11",
      "scope": "native-audio",
      "required": true,
      "os": [
        "macos"
      ],
      "title": "Free whole-system capture receives multiple sources"
    },
    {
      "id": "UPGRADE-01",
      "scope": "artifact",
      "required": true,
      "title": "Upgrade from a pinned previous candidate preserves user state and passes the complete installed suite"
    },
    {
      "id": "PKG-02",
      "scope": "artifact",
      "required": true,
      "title": "Remove the installed product while preserving saved session documents"
    },
    {
      "id": "STREAMDECK-01",
      "scope": "artifact",
      "required": true,
      "artifact": "macos-universal-streamdeck",
      "title": "Validate packed Stream Deck bytes, identity, DRM and runtime without running Stream Deck"
    }
  ],
