{
  "name": "mixrelay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lab:build": "node scripts/lab/native-check.mjs build",
    "lab:test": "node scripts/lab/native-check.mjs test",
    "lab:vm": "node scripts/lab/vm.mjs",
    "build": "pnpm --filter @mixrelay/control-ui build",
    "check": "pnpm check:audio-formats && pnpm check:ui-quality && pnpm --filter @mixrelay/control-ui check && pnpm check:native && pnpm check:rust",
    "check:audio-formats": "cargo test -p mixrelay-audio-io --lib format_contract::tests",
    "check:macos-engine": "cargo test -p mixrelay-engine-service --bin mixrelay-engine-service -- --test-threads=1",
    "check:native": "cargo test -p mixrelay-macos-transport -p mixrelay-hal-core -p mixrelay-macos-test-support && pnpm check:macos-engine && cargo run -p mixrelay-hal-bundle",
    "check:rust": "cargo fmt --all --check && cargo machete && cargo clippy --workspace --all-targets --all-features -- -D warnings && pnpm coverage:rust",
    "check:ui-quality": "biome check biome.json apps/control-ui",
    "coverage:rust": "cargo llvm-cov --workspace --lib --show-missing-lines --fail-under-functions 100 --fail-under-lines 100 --fail-under-regions 100 --fail-uncovered-functions 0 --fail-uncovered-lines 0 --fail-uncovered-regions 0",
    "desktop:build": "pnpm --filter @mixrelay/desktop tauri build",
    "desktop:build:macos-universal": "./scripts/build-macos-universal-app.sh",
    "desktop:dev": "pnpm --filter @mixrelay/desktop tauri dev",
    "format": "pnpm format:ui && pnpm format:rust",
    "format:rust": "cargo fmt --all",
    "format:ui": "biome check --write biome.json apps/control-ui",
    "hal:build:macos-universal": "cargo run -p mixrelay-hal-bundle --",
    "install:macos-dev-audio": "./scripts/install-macos-dev-audio.sh",
    "install:linux-dev-audio": "./scripts/install-linux-dev-audio.sh",
    "storybook": "pnpm --filter @mixrelay/control-ui storybook",
    "storybook:build": "pnpm --filter @mixrelay/control-ui build-storybook",
    "smoke:macos-dynamic-graph": "./scripts/smoke-macos-dynamic-graph.sh",
    "smoke:macos-installed-duplex": "./scripts/smoke-macos-installed-duplex.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11"
  }
}
