pkgname=mix-relay-driver
pkgver=@VERSION@
pkgrel=1
pkgdesc='Free virtual audio devices and native format controls'
arch=('@ARCH@')
url='https://mixrelay.com'
license=('LicenseRef-MixRelay-Driver')
depends=('glibc>=2.39' 'gcc-libs' 'gtk3' 'webkit2gtk-4.1' 'librsvg'
         'libayatana-appindicator' 'pipewire' 'libpipewire' 'wireplumber'
         'polkit' 'xterm' 'zenity' 'systemd' 'util-linux')
options=('!strip' '!debug')
install=mixrelay-driver.install
source=("$pkgname-$pkgver-$CARCH.tar.gz")
sha256sums=('@SHA256@')

package() {
  cp -a "$srcdir/payload/." "$pkgdir/"
}
