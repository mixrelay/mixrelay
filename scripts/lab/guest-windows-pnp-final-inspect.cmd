@echo off
setlocal
powershell.exe -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; if ((Get-CimInstance Win32_ComputerSystemProduct).UUID -ne '712A936E-9D91-4455-A8A9-A1F65EB60719') {throw 'VM mismatch'}; @{root=(Get-PnpDevice -InstanceId 'ROOT\MEDIA\0002' | Select-Object Status,InstanceId,FriendlyName); flags=(Get-PnpDeviceProperty -InstanceId 'ROOT\MEDIA\0002' -KeyName DEVPKEY_Device_DevNodeStatus,DEVPKEY_Device_ProblemCode,DEVPKEY_Device_ConfigFlags | Select-Object KeyName,Data); endpoints=@(Get-PnpDevice -Class AudioEndpoint | Where-Object FriendlyName -Like '*ToneNari SysVAD Bridge LAB*' | Select-Object Status,InstanceId,FriendlyName); processes=@(Get-Process -Name 'tonenari*' -ErrorAction SilentlyContinue | Select-Object Id,Name,SessionId)} | ConvertTo-Json -Depth 5 | Set-Content 'C:/ToneNariLab/pnp-v7-final.json'"
exit /b %errorlevel%
