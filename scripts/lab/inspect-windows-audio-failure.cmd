@echo off
powershell.exe -NoProfile -NonInteractive -Command "Get-WinEvent -FilterHashtable @{LogName='Application'; StartTime=(Get-Date).AddMinutes(-15)} -ErrorAction SilentlyContinue | Where-Object {$_.Id -in 1000,1001} | Select-Object TimeCreated,Id,Message | Format-List" > C:\ToneNariLab\audio-failure-events.log 2>&1
powershell.exe -NoProfile -NonInteractive -Command "Get-CimInstance Win32_Process | Where-Object {$_.CommandLine -like '*ToneNariLab*' -or $_.CommandLine -like '*audio-check.cmd*'} | Select-Object ProcessId,ParentProcessId,Name,CommandLine | Format-List; Get-ScheduledTask -TaskName 'ToneNariLabAudio' | Select-Object State; Get-ScheduledTaskInfo -TaskName 'ToneNariLabAudio'; Get-Content 'C:\Users\state303\audio-check.cmd'" > C:\ToneNariLab\audio-processes.log 2>&1
