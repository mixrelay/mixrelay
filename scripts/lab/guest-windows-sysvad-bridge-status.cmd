@echo off
rem Read-only diagnostic snapshot. No device/policy changes.
powershell.exe -NoProfile -NonInteractive -Command "$ErrorActionPreference='Stop'; if ((Get-CimInstance Win32_ComputerSystemProduct).UUID -ne '712A936E-9D91-4455-A8A9-A1F65EB60719') {throw 'Not the authorized VM'}; $d=@(Get-CimInstance Win32_PnPEntity | Where-Object {$_.HardwareID -contains 'Root\tonenari_SysvadBridge'}); $d | Select-Object Name,PNPDeviceID,ConfigManagerErrorCode,Status,Service | Format-List; foreach ($node in $d) {Get-PnpDeviceProperty -InstanceId $node.PNPDeviceID -KeyName DEVPKEY_Device_ProblemStatus,DEVPKEY_Device_ProblemCode | Format-List}; Get-CimInstance Win32_SystemDriver | Where-Object Name -eq 'tonenari_sysvadbridge' | Select-Object Name,State,PathName,ExitCode | Format-List; $svc=Get-CimInstance Win32_SystemDriver | Where-Object Name -eq 'tonenari_sysvadbridge'; if ($svc.State -eq 'Running') {Get-FileHash -LiteralPath $svc.PathName | Format-List}; if ($d.Count -eq 1) {Get-PnpDevice -Class AudioEndpoint -PresentOnly | Where-Object {(Get-PnpDeviceProperty -InstanceId $_.InstanceId -KeyName DEVPKEY_Device_Parent).Data -eq $d[0].PNPDeviceID} | Select-Object Status,FriendlyName,InstanceId | Format-List}; Get-WinEvent -FilterHashtable @{LogName='System';StartTime=(Get-Date).AddMinutes(-20);Level=2,3} -ErrorAction SilentlyContinue | Select-Object -First 10 TimeCreated,ProviderName,Id,Message | Format-List" > C:\ToneNariLab\sysvad-bridge-status.log 2>&1
exit /b %errorlevel%
