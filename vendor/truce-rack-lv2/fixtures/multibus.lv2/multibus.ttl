@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .

<urn:mixrelay:multibus-fixture>
    a lv2:Plugin ; doap:name "MixRelay multibus fixture" ;
    lv2:requiredFeature urid:map ; lv2:extensionData state:interface ;
    pg:mainInput <urn:mixrelay:multibus-fixture#main-in> ;
    pg:mainOutput <urn:mixrelay:multibus-fixture#main-out> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "main_l_in" ; lv2:name "Main left in" ; pg:group <urn:mixrelay:multibus-fixture#main-in> ],
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "side_in" ; lv2:name "Sidechain in" ; pg:group <urn:mixrelay:multibus-fixture#side> ],
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "main_r_in" ; lv2:name "Main right in" ; pg:group <urn:mixrelay:multibus-fixture#main-in> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; lv2:symbol "main_l_out" ; lv2:name "Main left out" ; pg:group <urn:mixrelay:multibus-fixture#main-out> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 4 ; lv2:symbol "aux_out" ; lv2:name "Auxiliary out" ; pg:group <urn:mixrelay:multibus-fixture#aux> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 5 ; lv2:symbol "main_r_out" ; lv2:name "Main right out" ; pg:group <urn:mixrelay:multibus-fixture#main-out> ] .

<urn:mixrelay:multibus-fixture#main-in> a pg:InputGroup ; lv2:symbol "main_in" .
<urn:mixrelay:multibus-fixture#side> a pg:InputGroup ; lv2:symbol "side" ; pg:sideChainOf <urn:mixrelay:multibus-fixture#main-in> .
<urn:mixrelay:multibus-fixture#main-out> a pg:OutputGroup ; lv2:symbol "main_out" .
<urn:mixrelay:multibus-fixture#aux> a pg:OutputGroup ; lv2:symbol "aux" .

# Metadata-only negative cases use the same bundle binary, but fail before instantiate.
<urn:mixrelay:multibus-ambiguous> a lv2:Plugin ; doap:name "MixRelay ambiguous groups" ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "a" ; lv2:name "A" ; pg:group <urn:mixrelay:multibus-ambiguous#a> ],
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "b" ; lv2:name "B" ; pg:group <urn:mixrelay:multibus-ambiguous#b> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out" ] .
<urn:mixrelay:multibus-ambiguous#a> lv2:symbol "group_a" .
<urn:mixrelay:multibus-ambiguous#b> lv2:symbol "group_b" .

<urn:mixrelay:multibus-conflict> a lv2:Plugin ; doap:name "MixRelay directional conflict" ;
    pg:mainInput <urn:mixrelay:multibus-conflict#both> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ; pg:group <urn:mixrelay:multibus-conflict#both> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out" ; pg:group <urn:mixrelay:multibus-conflict#both> ] .
<urn:mixrelay:multibus-conflict#both> lv2:symbol "both" .

<urn:mixrelay:multibus-indexed> a lv2:Plugin ; doap:name "MixRelay indexed element order" ;
    pg:mainInput <urn:mixrelay:multibus-indexed#pair> ;
    lv2:port
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "left" ; lv2:name "Left" ; lv2:designation pg:left ; pg:group <urn:mixrelay:multibus-indexed#pair> ],
        [ a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; lv2:symbol "right" ; lv2:name "Right" ; lv2:designation pg:right ; pg:group <urn:mixrelay:multibus-indexed#pair> ],
        [ a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; lv2:symbol "out" ; lv2:name "Out" ] .
<urn:mixrelay:multibus-indexed#pair> a pg:InputGroup ; lv2:symbol "pair" ;
    pg:element [ lv2:designation pg:right ; lv2:index 0 ],
               [ lv2:designation pg:left ; lv2:index 1 ] .

<urn:mixrelay:multibus-type-conflict> a lv2:Plugin ; doap:name "MixRelay wrong group direction" ;
    pg:mainInput <urn:mixrelay:multibus-type-conflict#wrong> ;
    lv2:port [ a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In" ; pg:group <urn:mixrelay:multibus-type-conflict#wrong> ] .
<urn:mixrelay:multibus-type-conflict#wrong> a pg:OutputGroup ; lv2:symbol "wrong" .
