+/* Do not consume another upstream quantum while a synchronous link still
+ * publishes an unread buffer. Async cycle slots retain their original policy.
+ * The node scheduler must continue activating downstream to release this slot.
+ */
+bool pw_impl_port_output_pending(struct pw_impl_port *port)
+{
+	struct impl *impl = SPA_CONTAINER_OF(port, struct impl, this);
+	struct pw_impl_port_mix *mix;
+
+	spa_list_for_each(mix, &impl->rt.mix_list, rt.link) {
+		struct spa_io_buffers *io = mix->io[0];
+		if (io != NULL && io == mix->io[1] &&
+		    SPA_ATOMIC_LOAD(io->status) == SPA_STATUS_HAVE_DATA &&
+		    io->buffer_id != SPA_ID_INVALID)
+			return true;
+	}
+	return false;
+}
