; Product-owned virtual render/capture pair. No third-party APO or sample binary.
[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
CatalogFile=MixRelayAudio.cat
DriverVer=09/07/2026,0.1.0.2
PnpLockdown=1

[Manufacturer]
%Provider%=MixRelay,NTarm64.10.0...19041

[MixRelay.NTarm64.10.0...19041]
%Device%=Install,Root\MixRelayVirtualAudio

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
MixRelayAudio.sys=1

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=AudioAdapter

[AudioAdapter]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,MixRelayAudio.sys
HKR,Drivers,SubClasses,,"wave"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%

[DriverCopy]
MixRelayAudio.sys

[Install.NT.Services]
AddService=MixRelayAudio,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\MixRelayAudio.sys

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,DeviceType,0x00010001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Install.NT.Interfaces]
AddInterface=%Audio%,WaveRender,WaveRender
AddInterface=%Render%,WaveRender,WaveRender
AddInterface=%Realtime%,WaveRender,WaveRender
AddInterface=%Audio%,TopologyRender,TopologyRender
AddInterface=%Topology%,TopologyRender,TopologyRender
AddInterface=%Audio%,WaveCapture,WaveCapture
AddInterface=%Capture%,WaveCapture,WaveCapture
AddInterface=%Realtime%,WaveCapture,WaveCapture
AddInterface=%Audio%,TopologyCapture,TopologyCapture
AddInterface=%Topology%,TopologyCapture,TopologyCapture

[WaveRender]
AddReg=WaveRenderProperties
[WaveCapture]
AddReg=WaveCaptureProperties
[TopologyRender]
AddReg=TopologyRenderProperties,EndpointProperties
[TopologyCapture]
AddReg=TopologyCaptureProperties,EndpointProperties

[WaveRenderProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
[WaveCaptureProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
[TopologyRenderProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
[TopologyCaptureProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
[EndpointProperties]
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[Strings]
Provider="MixRelay"
Device="MixRelay Virtual Audio"
Disk="MixRelay Virtual Audio driver"
RenderName="MixRelay Virtual I/O (to MixRelay)"
CaptureName="MixRelay Virtual I/O (from MixRelay)"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Capture="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
AnyNode="{00000000-0000-0000-0000-000000000000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
