{
  "name": "@tonenari/control-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build-storybook": "storybook build",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm build-storybook",
    "check:boundaries": "node scripts/check-ui-boundaries.mjs",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "9.6.0",
    "@mantine/hooks": "9.6.0",
    "i18next": "26.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
