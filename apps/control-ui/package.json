{
  "name": "@mixrelay/control-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:ui": "node scripts/audit-ui.mjs",
    "build": "tsc --noEmit && vite build && node ../../scripts/check-webkit-syntax.mjs dist",
    "build-storybook": "storybook build && node scripts/check-design-system-docs.mjs",
    "docs:api": "node scripts/check-design-system-docs.mjs --print-api",
    "docs:page": "node scripts/scaffold-component-doc.mjs",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm test:a11y && pnpm build && pnpm build-storybook",
    "check:boundaries": "node --test scripts/ui-boundary-rules.test.mjs scripts/audit-ui.test.mjs && node scripts/check-design-system-docs.mjs --self-test && node scripts/check-ui-boundaries.mjs",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --coverage",
    "test:a11y": "MIXRELAY_UI_A11Y=1 vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "^12.11.6",
    "i18next": "26.4.1",
    "react": "19.2.8",
    "react-aria-components": "1.22.0",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "css-tree": "3.2.1",
    "jsdom": "30.0.1",
    "remark-gfm": "4.0.1",
    "storybook": "10.5.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
