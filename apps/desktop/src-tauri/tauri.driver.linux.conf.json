{
  "mainBinaryName": "mixrelay-driver-manager",
  "app": {
    "windows": [{
      "label": "main", "title": "MixRelay Driver", "url": "index.html?mode=driver",
      "width": 400, "height": 180, "minWidth": 400, "minHeight": 180,
      "resizable": false, "visible": false
    }]
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "externalBin": ["binaries/mixrelay-driver-service"],
    "linux": {
      "deb": {
        "preInstallScript": "../../../packaging/linux/driver-before-change.sh",
        "postInstallScript": "../../../packaging/linux/driver-after-install.sh",
        "preRemoveScript": "../../../packaging/linux/driver-pre-remove.sh",
        "postRemoveScript": "../../../packaging/linux/driver-after-remove.sh",
        "desktopTemplate": "../../../packaging/linux/mixrelay-driver-manager.desktop",
