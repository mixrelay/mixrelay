          "/usr/share/doc/mix-relay/CHANGELOG.md": null,
          "/usr/share/doc/mix-relay/LICENSE.txt": null,
          "/usr/share/doc/mix-relay/LICENSE-Driver.txt": null,
          "/usr/lib/mixrelay/uninstall.sh": null,
