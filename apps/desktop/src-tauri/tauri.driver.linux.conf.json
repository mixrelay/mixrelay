        "depends": ["libpipewire-0.3-0t64", "libgcc-s1", "libc6", "libayatana-appindicator3-1", "pipewire", "wireplumber", "librsvg2-common", "pkexec", "xterm | x-terminal-emulator", "zenity", "systemd", "util-linux"]
      },
      "rpm": {
        "preInstallScript": "../../../packaging/linux/driver-before-change.sh",
        "postInstallScript": "../../../packaging/linux/driver-after-install.sh",
        "preRemoveScript": "../../../packaging/linux/driver-rpm-pre-remove.sh",
        "postRemoveScript": "../../../packaging/linux/driver-after-remove.sh",
        "desktopTemplate": "../../../packaging/linux/mixrelay-driver-manager.desktop",
        "files": {
          "/usr/share/doc/mix-relay/CHANGELOG.md": null,
          "/usr/share/doc/mix-relay/LICENSE.txt": null,
          "/usr/share/doc/mix-relay/LICENSE-Driver.txt": null,
