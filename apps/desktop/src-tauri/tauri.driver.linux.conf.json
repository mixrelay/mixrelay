          "/usr/lib/systemd/user/mixrelay-driver.service": "../../../packaging/linux/mixrelay-driver.service",
          "/etc/xdg/autostart/mixrelay-driver.desktop": "../../../packaging/linux/mixrelay-driver-autostart.desktop",
          "/usr/lib/mixrelay-driver/session-start.sh": "../../../packaging/linux/session-start.sh",
          "/usr/lib/mixrelay-driver/before-change.sh": "../../../packaging/linux/driver-before-change.sh",
          "/usr/lib/mixrelay-driver/uninstall.sh": "../../../packaging/linux/driver-uninstall.sh",
