          "/usr/share/applications/mixrelay-uninstall.desktop": null,
          "/usr/share/wireplumber/scripts/mixrelay-source-mute.lua": null,
          "/usr/share/wireplumber/wireplumber.conf.d/90-mixrelay-source-mute.conf": null,
