{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MixRelay",
  "version": "0.1.0",
  "identifier": "io.mixrelay.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../control-ui dev",
    "beforeBuildCommand": "pnpm --dir ../control-ui build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../control-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MixRelay",
        "width": 1180,
        "height": 780,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "14.2"
    }
  }
}
